// Detection Name: Phishing - AWS Lambda Function URL Credential Harvesting with Pre-filled Target Email
// MITRE ATT&CK: T1566.002 (Phishing: Spearphishing Link), T1583.006 (Acquire Infrastructure: Web Services), T1056.003 (Web Portal Capture)
// Author: Aamir Muhammad
let Lookback = 30d;
let LocalTimeZone = "Asia/Dubai";
let ToLocalSec = (t:datetime) { format_datetime(datetime_utc_to_local(t, LocalTimeZone), "yyyy-MM-dd HH:mm:ss") };
let LambdaUrlRegex = @'(?i)[a-z0-9]{32}\.lambda-url\.[a-z]{2}-[a-z]+-[0-9]\.on\.aws';
let EmailInParamRegex = @'(?i)[?&][a-z0-9_\-\.]+=([a-z0-9._%+\-]+(@|%40)[a-z0-9.\-]+\.[a-z]{2,})';
let EmailDelivered =
    EmailUrlInfo
    | where Timestamp > ago(Lookback)
    | where (Url has "lambda-url" or UrlDomain has "on.aws") and (Url  contains "@" or Url contains "%40")
    | where Url matches regex LambdaUrlRegex
    | extend LambdaHost = extract(LambdaUrlRegex, 0, Url)
    | extend LambdaId = extract(@'(?i)([a-z0-9]{32})\.lambda-url', 1, Url)
    | extend AwsRegion = extract(@'(?i)lambda-url\.([a-z]{2}-[a-z]+-[0-9])\.on\.aws', 1, Url)
    | extend TargetEmail = replace_string(tolower(extract(EmailInParamRegex, 1, Url)), "%40", "@")
    | extend TrackingParam = extract(@'(?i)[?&]([a-z0-9_\-\.]+)=[a-z0-9._%+\-]+(?:@|%40)', 1, Url)
    | join kind=leftouter (
        EmailEvents
        | where Timestamp > ago(Lookback)
        | project NetworkMessageId, Subject, SenderFromAddress, SenderMailFromAddress, SenderDisplayName,
                  SenderIPv4, RecipientEmailAddress, DeliveryAction, DeliveryLocation, EmailDirection,
                  ThreatTypes, ThreatNames, DetectionMethods, AuthenticationDetails, EmailClusterId
    ) on NetworkMessageId
    | extend Stage = iff(DeliveryLocation in ("Inbox/folder", "Inbox"), "1. *** EMAIL DELIVERED TO INBOX ***", "1. Email received (quarantined/junk)")
    | project Timestamp, Stage, LambdaHost, LambdaId, AwsRegion, TrackingParam, TargetEmail,
              Url, Identity = coalesce(RecipientEmailAddress, TargetEmail), DeviceNameOut = "",
              Detail = strcat("Recipient: ", RecipientEmailAddress,
                              "\nPre-filled target in URL: ", TargetEmail,
                              "\nTracking param: ", TrackingParam,
                              "\nSubject: ", Subject,
                              "\nSender: ", SenderFromAddress, " (envelope: ", SenderMailFromAddress, ")",
                              "\nSender display: ", SenderDisplayName, "   SenderIP: ", SenderIPv4,
                              "\nDelivery: ", DeliveryAction, " to ", DeliveryLocation,
                              "\nThreat: ", ThreatTypes, " ", ThreatNames, " (", DetectionMethods, ")",
                              "\nAuth (SPF/DKIM/DMARC): ", AuthenticationDetails,
                              "\nCluster: ", EmailClusterId,
                              "\nURL: ", Url);
let UrlClicked =
    UrlClickEvents
    | where Timestamp > ago(Lookback)
    | where (Url has "lambda-url" or tostring(UrlChain) has "lambda-url") and (Url  contains "@" or Url contains "%40")
    | where Url matches regex LambdaUrlRegex or tostring(UrlChain) matches regex LambdaUrlRegex
    | extend FullChain = strcat(Url, " ", tostring(UrlChain))
    | extend LambdaHost = extract(LambdaUrlRegex, 0, FullChain)
    | extend LambdaId = extract(@'(?i)([a-z0-9]{32})\.lambda-url', 1, FullChain)
    | extend AwsRegion = extract(@'(?i)lambda-url\.([a-z]{2}-[a-z]+-[0-9])\.on\.aws', 1, FullChain)
    | extend TargetEmail = replace_string(tolower(extract(EmailInParamRegex, 1, FullChain)), "%40", "@")
    | extend TrackingParam = extract(@'(?i)[?&]([a-z0-9_\-\.]+)=[a-z0-9._%+\-]+(?:@|%40)', 1, FullChain)
    | extend Stage = case(
        tostring(IsClickedThrough) in ("1", "true", "True"), "2. *** USER CLICKED THROUGH SAFE LINKS WARNING ***",
        ActionType =~ "ClickBlocked", "2. Click blocked by Safe Links",
        "2. *** URL CLICKED ***")
    | project Timestamp, Stage, LambdaHost, LambdaId, AwsRegion, TrackingParam, TargetEmail,
              Url, Identity = AccountUpn, DeviceNameOut = "",
              Detail = strcat("Clicked by: ", AccountUpn,
                              "\nPre-filled target in URL: ", TargetEmail,
                              "\nAction: ", ActionType,
                              "\nClicked through warning: ", tostring(IsClickedThrough),
                              "\nSource IP: ", IPAddress,
                              "\nWorkload: ", Workload,
                              "\nThreatTypes: ", ThreatTypes,
                              "\nDetection: ", DetectionMethods,
                              "\nURL chain: ", tostring(UrlChain));
let NetworkContact =
    DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where ((RemoteUrl has "lambda-url" or RemoteUrl has "on.aws") or (tostring(AdditionalFields) has "lambda-url")) and (RemoteUrl contains "@" or RemoteUrl contains "%40" or AdditionalFields  contains "@" or AdditionalFields  contains "%40")
    | extend FullCtx = strcat(coalesce(RemoteUrl, ""), " ", tostring(AdditionalFields))
    | where FullCtx matches regex LambdaUrlRegex
    | extend LambdaHost = extract(LambdaUrlRegex, 0, FullCtx)
    | extend LambdaId = extract(@'(?i)([a-z0-9]{32})\.lambda-url', 1, FullCtx)
    | extend AwsRegion = extract(@'(?i)lambda-url\.([a-z]{2}-[a-z]+-[0-9])\.on\.aws', 1, FullCtx)
    | extend TargetEmail = replace_string(tolower(extract(EmailInParamRegex, 1, FullCtx)), "%40", "@")
    | extend TrackingParam = extract(@'(?i)[?&]([a-z0-9_\-\.]+)=[a-z0-9._%+\-]+(?:@|%40)', 1, FullCtx)
    | project Timestamp, Stage = "3. *** ENDPOINT CONNECTED TO LAMBDA URL ***",
              LambdaHost, LambdaId, AwsRegion, TrackingParam, TargetEmail,
              Url = coalesce(RemoteUrl, LambdaHost),
              Identity = strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName),
              DeviceNameOut = DeviceName,
              Detail = strcat("Device: ", DeviceName,
                              "\nAccount: ", InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName,
                              "\nProcess: ", InitiatingProcessFolderPath,
                              "\nCmd: ", InitiatingProcessCommandLine,
                              "\nAction: ", ActionType,
                              "\nRemoteIP: ", RemoteIP, ":", tostring(RemotePort),
                              "\nURL: ", RemoteUrl);
let CloudAppContact =
    CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where tostring(RawEventData) has "lambda-url"
    | where tostring(RawEventData) matches regex LambdaUrlRegex
    | extend LambdaHost = extract(LambdaUrlRegex, 0, tostring(RawEventData))
    | extend LambdaId = extract(@'(?i)([a-z0-9]{32})\.lambda-url', 1, tostring(RawEventData))
    | extend AwsRegion = extract(@'(?i)lambda-url\.([a-z]{2}-[a-z]+-[0-9])\.on\.aws', 1, tostring(RawEventData))
    | project Timestamp, Stage = "4. Lambda URL referenced in cloud app activity",
              LambdaHost, LambdaId, AwsRegion, TrackingParam = "", TargetEmail = "",
              Url = LambdaHost, Identity = coalesce(AccountDisplayName, AccountId), DeviceNameOut = "",
              Detail = strcat("Action: ", ActionType,
                              "\nApp: ", Application,
                              "\nAccount: ", coalesce(AccountDisplayName, AccountId),
                              "\nIP: ", IPAddress,
                              "\nUserAgent: ", UserAgent);
union EmailDelivered, UrlClicked, NetworkContact, CloudAppContact
| extend TimeLocal = ToLocalSec(Timestamp)
| extend Details = strcat(Stage,
                          "\nTime: ", TimeLocal, " (", LocalTimeZone, ")",
                          "\nLambda host: ", LambdaHost,
                          "\nFunction ID: ", LambdaId,
                          "\nAWS region: ", AwsRegion,
                          "\n", Detail)
| sort by Timestamp asc
| project TimeLocal, Stage, LambdaHost, LambdaId, AwsRegion, TrackingParam, TargetEmail,
          Identity, DeviceNameOut, Url, Details, Timestamp
